#!/bin/sh
# vfzf - select files for an editor; fzf quotes each filename for become.
set -e

# Shared options are optional; the search command works even from a WM shortcut.
config=${XDG_CONFIG_HOME:-$HOME/.config}/fzf/config.sh
[ ! -r "$config" ] || . "$config"
set -u
export FZF_DEFAULT_COMMAND='fzf-files edit'

# An optional first argument chooses the directory to search.
[ "$#" -eq 0 ] || cd -- "$1"

# become hands the terminal to the editor; {+} quotes the selected filenames.
# Expand the editor command before fzf's shell parses it (zsh does not split $var).
# Colon form keeps editor punctuation out of fzf's binding delimiters.
open="become:${EDITOR:-nvim} -O -- {+}"
exec fzf --read0 --prompt='NeoVim: ' --bind="enter:$open" --bind="ctrl-l:$open"
