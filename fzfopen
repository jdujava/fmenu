#!/usr/bin/env python3
"""An open-with menu. GIO handles desktop entries and MIME associations for us."""
import os
from pathlib import Path
import subprocess
import sys
from gi.repository import Gio, GLib

if len(sys.argv) != 2:
    sys.exit("Usage: fzfopen FILE")

path = Path(sys.argv[1]).expanduser().absolute()

try:
    info = Gio.File.new_for_path(str(path)).query_info(
        "standard::content-type", Gio.FileQueryInfoFlags.NONE, None,
    )
    apps = Gio.AppInfo.get_all_for_type(info.get_content_type())

    # Show names people recognize, but keep desktop IDs for an exact launch.
    # Flatten embedded newlines so each application occupies one menu line.
    entries = {}
    for app in apps:
        if app.get_id():
            name = " ".join(app.get_display_name().splitlines())
            entries[f"{name:<35} │ {app.get_id()}"] = app.get_id()

    if not entries:
        sys.exit(f"fzfopen: no application registered for {info.get_content_type()}")

    choice = subprocess.run(
        ["fmenu", "-g", "100x15", "-p", "Open with:", "--", "--tiebreak=begin"],
        input="\n".join(sorted(entries, key=str.casefold)) + "\n",
        text=True, stdout=subprocess.PIPE,
    )
    selected = choice.stdout.strip()
    if choice.returncode or selected not in entries:
        sys.exit(0)

    os.execvp("gtk-launch", ["gtk-launch", entries[selected], str(path)])
except (OSError, GLib.Error) as error:
    sys.exit(f"fzfopen: {error}")
