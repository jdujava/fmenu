#!/bin/sh
# Select PDF, DjVu or PostScript files and open each in Zathura.
set -e

config=${XDG_CONFIG_HOME:-$HOME/.config}/fzf/config.sh
[ ! -r "$config" ] || . "$config"
set -u
export FZF_DEFAULT_COMMAND='fzf-files document'

[ "$#" -eq 0 ] || cd -- "$1"

# NUL separators preserve every filename; -r leaves cancellation alone.
fzf --read0 --print0 --prompt='Zathura: ' | xargs -0 -r zathura --fork --
