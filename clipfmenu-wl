#!/bin/sh
# Select a cliphist entry and restore its original text or image.
set -eu

# The same file holds the menu input, then the decoded selection. This avoids
# replacing the clipboard while cliphist is still reading from it.
temp=$(mktemp "${XDG_RUNTIME_DIR:?Start inside Wayland}/mango-clip.XXXXXXXX")
trap 'rm -f -- "$temp"' EXIT
trap 'exit 1' HUP INT TERM

cliphist list > "$temp"
selection=$(fmenu -g 75x20 -p 'Clipboard:' -- --no-sort < "$temp") || exit 0
[ -n "$selection" ] || exit 0

# Decode completely before touching the current clipboard; preserve images.
printf '%s\n' "$selection" | cliphist decode > "$temp" || exit 1
wl-copy < "$temp"
